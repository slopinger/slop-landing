[Unit]
Description=slopd: guestbook + visitor counter API for slop.kyouma.net
After=network.target

[Service]
Type=simple
User=slopd
Group=slopd
ExecStart=/usr/bin/python3 -I /usr/local/lib/slopd/slopd.py --db /var/lib/slopd/slopd.sqlite3 serve --host 127.0.0.1 --port 8787
StateDirectory=slopd
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

# Sandboxing: slopd only needs its state dir and a loopback socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
