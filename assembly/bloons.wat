(module
  ;; Handwritten Wasm engine, ABI v3. Header 0..63, immutable stats at 512.
  ;; Towers retain their v1 layout at 12288, effects at 24576.
  ;; Balloons: 4096 slots * 64 bytes at 65536. No host simulation imports.
  (memory (export "memory") 40 40)
  ;; @UPGRADE_DATA
  (data (i32.const 512) "\01\00\00\00\00\00\80\3f\ff\ff\ff\ff\00\00\00\00\ff\ff\ff\ff\00\00\00\00\01\00\00\00\0c\00\00\00\01\00\00\00\33\33\b3\3f\00\00\00\00\01\00\00\00\ff\ff\ff\ff\00\00\00\00\02\00\00\00\0c\00\00\00\01\00\00\00\66\66\e6\3f\01\00\00\00\01\00\00\00\ff\ff\ff\ff\00\00\00\00\03\00\00\00\0c\00\00\00\01\00\00\00\cd\cc\4c\40\02\00\00\00\01\00\00\00\ff\ff\ff\ff\00\00\00\00\04\00\00\00\0c\00\00\00\01\00\00\00\00\00\60\40\03\00\00\00\01\00\00\00\ff\ff\ff\ff\00\00\00\00\05\00\00\00\0c\00\00\00\01\00\00\00\66\66\e6\3f\04\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\06\00\00\00\0a\00\00\00\01\00\00\00\00\00\00\40\04\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\06\00\00\00\0a\00\00\00\01\00\00\00\00\00\40\40\04\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\06\00\00\00\0c\00\00\00\01\00\00\00\00\00\80\3f\05\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\07\00\00\00\0c\00\00\00\01\00\00\00\66\66\e6\3f\05\00\00\00\01\00\00\00\06\00\00\00\01\00\00\00\07\00\00\00\0c\00\00\00\01\00\00\00\cd\cc\0c\40\09\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\08\00\00\00\0c\00\00\00\0a\00\00\00\00\00\20\40\0a\00\00\00\02\00\00\00\ff\ff\ff\ff\00\00\00\00\09\00\00\00\0f\00\00\00\c8\00\00\00\00\00\80\3f\0b\00\00\00\04\00\00\00\ff\ff\ff\ff\00\00\00\00\0a\00\00\00\1c\00\00\00\bc\02\00\00\00\00\80\3e\0c\00\00\00\04\00\00\00\ff\ff\ff\ff\00\00\00\00\0b\00\00\00\24\00\00\00\a0\0f\00\00\ec\51\38\3e\0d\00\00\00\04\00\00\00\ff\ff\ff\ff\00\00\00\00\0c\00\00\00\2a\00\00\00\90\01\00\00\00\00\30\40\0b\00\00\00\04\00\00\00\ff\ff\ff\ff\00\00\00\00\0d\00\00\00\1c\00\00\00\20\4e\00\00\ec\51\38\3e\0e\00\00\00\02\00\00\00\0f\00\00\00\03\00\00\00\0e\00\00\00\34\00\00\00")
  ;; @ROUND_DATA
  (global $groupStart (mut i32) (i32.const 0))
  (global $groupCount (mut i32) (i32.const 0))
  (global $event (mut i32) (i32.const 0))
  (global $end (mut i32) (i32.const 65536))
  (global $attack (mut i32) (i32.const 0))
  (global $reserved (mut i32) (i32.const 0))
  (global $alloc (mut i32) (i32.const 65536))
  (func $add (param $p i32) (param $n i32)
    (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (local.get $n))))
  (func $sq (param $x f32) (result f32) (f32.mul (local.get $x) (local.get $x)))
  (func $dist (param $x f32) (param $y f32) (param $a f32) (param $b f32) (result f32)
    (f32.add (call $sq (f32.sub (local.get $x) (local.get $a)))
             (call $sq (f32.sub (local.get $y) (local.get $b)))))
  (func $stat (param $type i32) (result i32)
    (i32.add (i32.const 512) (i32.mul (local.get $type) (i32.const 32))))
  (func $health (export "health") (param $type i32) (param $flags i32) (result i32)
    (local $hp i32)
    (if (i32.gt_u (local.get $type) (i32.const 16)) (then (return (i32.const 0))))
    (local.set $hp (i32.load (call $stat (local.get $type))))
    (if (i32.and (local.get $flags) (i32.const 4)) (then
      (if (i32.eq (local.get $type) (i32.const 8)) (then (return (i32.const 4))))
      (if (i32.ge_u (local.get $type) (i32.const 11))
        (then (local.set $hp (i32.mul (local.get $hp) (i32.const 2)))))))
    (local.get $hp))
  (func $flags (param $type i32) (param $flags i32) (result i32)
    (local.set $flags (i32.and (local.get $flags) (i32.const 7)))
    (if (i32.and (i32.ne (local.get $type) (i32.const 8)) (i32.lt_u (local.get $type) (i32.const 11)))
      (then (local.set $flags (i32.and (local.get $flags) (i32.const 3)))))
    (if (i32.ge_u (local.get $type) (i32.const 12))
      (then (local.set $flags (i32.and (local.get $flags) (i32.const 5)))))
    (if (i32.eq (local.get $type) (i32.const 15))
      (then (local.set $flags (i32.or (local.get $flags) (i32.const 1)))))
    (local.get $flags))
  (func $child_flags (param $type i32) (param $flags i32) (result i32)
    (if (i32.eq (local.get $type) (i32.const 15))
      (then (return (i32.or (local.get $flags) (i32.const 2)))))
    (if (i32.lt_u (local.get $type) (i32.const 12))
      (then (local.set $flags (i32.and (local.get $flags) (i32.const 3)))))
    (local.get $flags))
  (func $rbe (export "rbe") (param $type i32) (param $flags i32) (result i32)
    (local $s i32) (local $n i32) (local $f i32)
    (if (i32.gt_u (local.get $type) (i32.const 16)) (then (return (i32.const 0))))
    (local.set $s (call $stat (local.get $type)))
    (local.set $f (call $child_flags (local.get $type) (local.get $flags)))
    (local.set $n (call $health (local.get $type) (local.get $flags)))
    (if (i32.load offset=12 (local.get $s)) (then
      (local.set $n (i32.add (local.get $n) (i32.mul (i32.load offset=12 (local.get $s))
        (call $rbe (i32.load offset=8 (local.get $s)) (local.get $f)))))))
    (if (i32.load offset=20 (local.get $s)) (then
      (local.set $n (i32.add (local.get $n) (i32.mul (i32.load offset=20 (local.get $s))
        (call $rbe (i32.load offset=16 (local.get $s)) (local.get $f)))))))
    (local.get $n))
  (func (export "pool_end") (result i32) (global.get $end))
  ;; Track length 1783. Return x or y at distance d.
  (func $pos (export "position") (param $d f32) (param $axis i32) (result f32)
    (if (f32.lt (local.get $d) (f32.const 164))
      (then (return (select (f32.const 110) (f32.sub (local.get $d) (f32.const 24)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 334))
      (then (return (select (f32.sub (local.get $d) (f32.const 54)) (f32.const 140) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 524))
      (then (return (select (f32.const 280) (f32.sub (local.get $d) (f32.const 194)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 704))
      (then (return (select (f32.sub (f32.const 804) (local.get $d)) (f32.const 330) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 894))
      (then (return (select (f32.const 100) (f32.sub (local.get $d) (f32.const 374)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1164))
      (then (return (select (f32.sub (local.get $d) (f32.const 794)) (f32.const 520) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1354))
      (then (return (select (f32.const 370) (f32.sub (local.get $d) (f32.const 644)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1509))
      (then (return (select (f32.sub (f32.const 1724) (local.get $d)) (f32.const 710) (local.get $axis)))))
    (select (f32.const 215) (f32.sub (local.get $d) (f32.const 799)) (local.get $axis)))

  (func (export "reset") (param $sandbox i32)
    (memory.fill (i32.const 0) (i32.const 0) (i32.const 512))
    (memory.fill (i32.const 2048) (i32.const 0) (i32.const 325632))
    (call $reset_projectiles)
    (i32.store (i32.const 32) (i32.ne (local.get $sandbox) (i32.const 0)))
    (i32.store (i32.const 0) (select (i32.const 999999) (i32.const 650) (local.get $sandbox)))
    (i32.store (i32.const 4) (select (i32.const 999999) (i32.const 150) (local.get $sandbox)))
    (global.set $event (i32.const 0))
    (global.set $end (i32.const 65536))
    (global.set $alloc (i32.const 65536))
    (global.set $attack (i32.const 0))
    (global.set $reserved (i32.const 0)))
  ;; @UPGRADES
  (func $can_place (export "can_place") (param $x f32) (param $y f32) (result i32)
    (local $d f32) (local $t i32)
    (if (i32.or (f32.ne (local.get $x) (local.get $x)) (f32.ne (local.get $y) (local.get $y)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.or (f32.lt (local.get $x) (f32.const 24)) (f32.gt (local.get $x) (f32.const 936)))
                (i32.or (f32.lt (local.get $y) (f32.const 26)) (f32.gt (local.get $y) (f32.const 454))))
      (then (return (i32.const 0))))
    (loop $track
      (if (f32.lt (call $dist (local.get $x) (local.get $y)
        (call $pos (local.get $d) (i32.const 0)) (call $pos (local.get $d) (i32.const 1))) (f32.const 2304))
        (then (return (i32.const 0))))
      (local.set $d (f32.add (local.get $d) (f32.const 12)))
      (br_if $track (f32.le (local.get $d) (f32.const 1783))))
    (local.set $t (i32.const 12288))
    (loop $towers
      (if (i32.load (local.get $t))
        (then (if (f32.lt (call $dist (local.get $x) (local.get $y)
          (f32.load offset=4 (local.get $t)) (f32.load offset=8 (local.get $t))) (f32.const 1936))
          (then (return (i32.const 0))))))
      (local.set $t (i32.add (local.get $t) (i32.const 48)))
      (br_if $towers (i32.lt_u (local.get $t) (i32.const 14592))))
    (i32.const 1))
  (func (export "place") (param $type i32) (param $x f32) (param $y f32) (result i32)
    (local $t i32) (local $price i32)
    (if (i32.or (i32.gt_u (local.get $type) (i32.const 5)) (i32.ge_u (i32.load (i32.const 12)) (i32.const 2)))
      (then (return (i32.const -1))))
    (local.set $price (call $cost (local.get $type)))
    (if (i32.or (i32.lt_s (i32.load (i32.const 0)) (local.get $price))
      (i32.eqz (call $can_place (local.get $x) (local.get $y)))) (then (return (i32.const -1))))
    (local.set $t (i32.const 12288))
    (loop $find
      (if (i32.eqz (i32.load (local.get $t)))
        (then
          (memory.fill (local.get $t) (i32.const 0) (i32.const 48))
          (i32.store (local.get $t) (i32.const 1))
          (f32.store offset=4 (local.get $t) (local.get $x))
          (f32.store offset=8 (local.get $t) (local.get $y))
          (i32.store offset=12 (local.get $t) (local.get $type))
          (i32.store offset=36 (local.get $t) (local.get $price))
          (memory.fill (call $tx (local.get $t)) (i32.const 0) (i32.const 128))
          (global.set $towerSerial (i32.add (global.get $towerSerial) (i32.const 1)))
          (i32.store offset=44 (local.get $t) (global.get $towerSerial))
          (call $configure (local.get $t))
          (call $add (i32.const 0) (i32.sub (i32.const 0) (local.get $price)))
          (return (i32.div_u (i32.sub (local.get $t) (i32.const 12288)) (i32.const 48)))))
      (local.set $t (i32.add (local.get $t) (i32.const 48)))
      (br_if $find (i32.lt_u (local.get $t) (i32.const 14592))))
    (i32.const -1))
  (func $tower (param $id i32) (result i32)
    (if (i32.ge_u (local.get $id) (i32.const 48)) (then (return (i32.const 0))))
    (i32.add (i32.const 12288) (i32.mul (local.get $id) (i32.const 48))))
  (func (export "sell") (param $id i32) (result i32)
    (local $t i32) (local $cash i32)
    (local.set $t (call $tower (local.get $id)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (i32.load (local.get $t))) (i32.ge_u (i32.load (i32.const 12)) (i32.const 2)))
      (then (return (i32.const 0))))
    (local.set $cash (i32.div_u (i32.mul (i32.load offset=36 (local.get $t)) (i32.const 7)) (i32.const 10)))
    (call $add (i32.const 0) (local.get $cash))
    (i32.store (local.get $t) (i32.const 0))
    (local.get $cash))


  ;; @PROJECTILES
  ;; Cash counts one coin per shell, independently of multi-HP damage/RBE.
  (func $cash_rbe (param $type i32) (result i32)
    (local $s i32) (local $total i32)
    (local.set $s (call $stat (local.get $type)))
    (local.set $total (i32.const 1))
    (if (i32.load offset=12 (local.get $s)) (then
      (local.set $total (i32.add (local.get $total) (i32.mul (i32.load offset=12 (local.get $s))
        (call $cash_rbe (i32.load offset=8 (local.get $s))))))))
    (if (i32.load offset=20 (local.get $s)) (then
      (local.set $total (i32.add (local.get $total) (i32.mul (i32.load offset=20 (local.get $s))
        (call $cash_rbe (i32.load offset=16 (local.get $s))))))))
    (local.get $total))
  (func $new (param $type i32) (param $flags i32) (param $d f32) (param $chain i32)
    (param $paid i32) (param $cashpaid i32) (param $parent i32)
    (param $popBudget i32) (param $cashBudget i32) (result i32)
    (local $b i32) (local $tries i32)
    (if (i32.ge_u (i32.add (i32.load (i32.const 20)) (global.get $reserved)) (i32.const 4096)) (then (return (i32.const 0))))
    (local.set $b (global.get $alloc))
    (loop $slot
      (if (i32.load (local.get $b)) (then
        (local.set $b (i32.add (local.get $b) (i32.const 64)))
        (if (i32.ge_u (local.get $b) (i32.const 327680)) (then (local.set $b (i32.const 65536))))
        (local.set $tries (i32.add (local.get $tries) (i32.const 1)))
        (br_if $slot (i32.lt_u (local.get $tries) (i32.const 4096))))))
    (if (i32.load (local.get $b)) (then (return (i32.const 0))))
    (local.set $flags (call $flags (local.get $type) (local.get $flags)))
    (call $born (local.get $b) (local.get $parent))
    (memory.fill (local.get $b) (i32.const 0) (i32.const 64))
    (i32.store (local.get $b) (i32.const 1))
    (f32.store offset=4 (local.get $b) (local.get $d))
    (f32.store offset=8 (local.get $b) (call $pos (local.get $d) (i32.const 0)))
    (f32.store offset=12 (local.get $b) (call $pos (local.get $d) (i32.const 1)))
    (if (call $can_damage (local.get $type) (local.get $flags) (i32.const 0) (i32.const 2) (i32.const 1) (i32.load offset=24 (call $bm (local.get $b))))
      (then (i32.store offset=24 (local.get $b) (i32.load offset=20 (call $bm (local.get $b))))))
    (i32.store offset=28 (call $bm (local.get $b)) (select
      (call $rbe (local.get $type) (local.get $flags)) (local.get $popBudget) (i32.lt_s (local.get $popBudget) (i32.const 0))))
    (i32.store offset=20 (call $bm (local.get $b)) (select
      (call $cash_rbe (local.get $type)) (local.get $cashBudget) (i32.lt_s (local.get $cashBudget) (i32.const 0))))
    (i32.store offset=16 (local.get $b) (call $health (local.get $type) (local.get $flags)))
    (i32.store offset=20 (local.get $b) (local.get $type))
    (i32.store offset=32 (local.get $b) (local.get $flags))
    (i32.store offset=36 (local.get $b) (i32.or (local.get $chain) (i32.shl (i32.const 1) (local.get $type))))
    (i32.store offset=40 (local.get $b) (i32.const 180))
    (i32.store offset=44 (local.get $b) (local.get $paid))
    (i32.store offset=48 (local.get $b) (i32.load (i32.const 28)))
    (i32.store offset=52 (local.get $b) (select (i32.const 0) (call $health (local.get $type) (local.get $flags))
      (i32.and (local.get $paid) (i32.shl (i32.const 1) (local.get $type)))))
    (i32.store offset=56 (local.get $b) (global.get $attack))
    (i32.store offset=60 (local.get $b) (local.get $cashpaid))
    (call $add (i32.const 20) (i32.const 1))
    (if (global.get $gridReady) (then (call $grid_insert (local.get $b))))
    (global.set $alloc (i32.add (local.get $b) (i32.const 64)))
    (if (i32.gt_u (global.get $alloc) (global.get $end)) (then (global.set $end (global.get $alloc))))
    (if (i32.ge_u (global.get $alloc) (i32.const 327680)) (then (global.set $alloc (i32.const 65536))))
    (local.get $b))
  (func (export "send_bloon") (param $type i32) (param $flags i32) (param $count i32) (result i32)
    (local $n i32)
    (if (i32.or (i32.eqz (i32.load (i32.const 32))) (i32.ge_u (i32.load (i32.const 12)) (i32.const 2)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.gt_u (local.get $type) (i32.const 16))
      (i32.or (i32.gt_u (local.get $flags) (i32.const 7))
        (i32.or (i32.eqz (local.get $count)) (i32.gt_u (local.get $count) (i32.const 100)))))
      (then (return (i32.const 0))))
    (if (i32.gt_u (i32.add (i32.load (i32.const 20)) (local.get $count)) (i32.const 4096))
      (then (return (i32.const 0))))
    (loop $send
      (drop (call $new (local.get $type) (local.get $flags)
        (f32.mul (f32.convert_i32_s (local.get $n)) (f32.const -28)) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const -1) (i32.const -1)))
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (br_if $send (i32.lt_u (local.get $n) (local.get $count))))
    (i32.store (i32.const 12) (i32.const 1))
    (local.get $n))
  (func (export "clear_bloons") (result i32)
    (if (i32.eqz (i32.load (i32.const 32))) (then (return (i32.const 0))))
    (memory.fill (i32.const 65536) (i32.const 0) (i32.const 262144))
    (memory.fill (i32.const 24576) (i32.const 0) (i32.const 6144))
    (call $clear_projectiles)
    (i32.store (i32.const 20) (i32.const 0))
    (i32.store (i32.const 24) (i32.const 0))
    (i32.store (i32.const 36) (i32.const 0))
    (i32.store (i32.const 12) (i32.const 0))
    (i32.store (i32.const 4) (i32.const 999999))
    (global.set $end (i32.const 65536))
    (global.set $alloc (i32.const 65536))
    (i32.const 1))
  (func (export "start") (result i32)
    (local $index i32) (local $g i32) (local $p i32)
    (if (i32.or (i32.load (i32.const 12)) (i32.load (i32.const 32))) (then (return (i32.const 0))))
    (if (i32.ge_u (i32.load (i32.const 8)) (i32.const 40)) (then (return (i32.const 0))))
    (call $add (i32.const 8) (i32.const 1))
    (local.set $index (i32.add (i32.const 327680) (i32.mul (i32.load (i32.const 8)) (i32.const 8))))
    (global.set $groupStart (i32.load (local.get $index)))
    (global.set $groupCount (i32.load offset=4 (local.get $index)))
    (memory.fill (i32.const 2048) (i32.const 0) (i32.const 512))
    (i32.store (i32.const 24) (i32.const 0))
    (i32.store (i32.const 40) (i32.const 0))
    (loop $count
      (local.set $p (i32.add (global.get $groupStart) (i32.mul (local.get $g) (i32.const 24))))
      (call $add (i32.const 24) (i32.load offset=8 (local.get $p)))
      (local.set $g (i32.add (local.get $g) (i32.const 1)))
      (br_if $count (i32.lt_u (local.get $g) (global.get $groupCount))))
    (i32.store (i32.const 12) (i32.const 1))
    (i32.const 1))
  (func $spawn_balloon
    (local $g i32) (local $p i32) (local $counter i32) (local $sent i32) (local $count i32) (local $due i32)
    (loop $groups
      (local.set $p (i32.add (global.get $groupStart) (i32.mul (local.get $g) (i32.const 24))))
