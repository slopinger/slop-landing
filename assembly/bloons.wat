(module
  ;; Hand-written WebAssembly assembly. No imports: simulation and rules live here.
  ;; Header: cash, lives, wave, phase (ready/running/lost/won), pops, active,
  ;; remaining spawns, ticks. Balloons at 1024 (256 * 32), towers at 12288
  ;; (48 * 48), visual events at 24576 (256 * 24). All fields are 32-bit.
  (memory (export "memory") 1 1)
  (global $spawn (mut i32) (i32.const 0))
  (global $serial (mut i32) (i32.const 0))
  (global $event (mut i32) (i32.const 0))
  (func $add (param $p i32) (param $n i32)
    (i32.store (local.get $p) (i32.add (i32.load (local.get $p)) (local.get $n))))
  (func $sq (param $x f32) (result f32) (f32.mul (local.get $x) (local.get $x)))
  (func $dist (param $x f32) (param $y f32) (param $a f32) (param $b f32) (result f32)
    (f32.add (call $sq (f32.sub (local.get $x) (local.get $a)))
             (call $sq (f32.sub (local.get $y) (local.get $b)))))
  ;; Track length 1783. Return x or y at distance d.
  (func $pos (export "position") (param $d f32) (param $axis i32) (result f32)
    (if (f32.lt (local.get $d) (f32.const 164))
      (then (return (select (f32.const 110) (f32.sub (local.get $d) (f32.const 24)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 334))
      (then (return (select (f32.sub (local.get $d) (f32.const 54)) (f32.const 140) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 524))
      (then (return (select (f32.const 280) (f32.sub (local.get $d) (f32.const 194)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 704))
      (then (return (select (f32.sub (f32.const 804) (local.get $d)) (f32.const 330) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 894))
      (then (return (select (f32.const 100) (f32.sub (local.get $d) (f32.const 374)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1164))
      (then (return (select (f32.sub (local.get $d) (f32.const 794)) (f32.const 520) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1354))
      (then (return (select (f32.const 370) (f32.sub (local.get $d) (f32.const 644)) (local.get $axis)))))
    (if (f32.lt (local.get $d) (f32.const 1509))
      (then (return (select (f32.sub (f32.const 1724) (local.get $d)) (f32.const 710) (local.get $axis)))))
    (select (f32.const 215) (f32.sub (local.get $d) (f32.const 799)) (local.get $axis)))
  (func (export "reset")
    (memory.fill (i32.const 0) (i32.const 0) (i32.const 65536))
    (i32.store (i32.const 0) (i32.const 650))
    (i32.store (i32.const 4) (i32.const 100))
    (global.set $spawn (i32.const 0))
    (global.set $serial (i32.const 0))
    (global.set $event (i32.const 0)))
  (func $cost (export "cost") (param $type i32) (result i32)
    (if (i32.eqz (local.get $type)) (then (return (i32.const 180))))
    (if (i32.eq (local.get $type) (i32.const 1)) (then (return (i32.const 260))))
    (if (i32.eq (local.get $type) (i32.const 2)) (then (return (i32.const 420))))
    (if (i32.eq (local.get $type) (i32.const 4)) (then (return (i32.const 2000))))
    (i32.const 320))
  (func $range (export "range") (param $type i32) (param $level i32) (result f32)
    (if (i32.eq (local.get $type) (i32.const 4))
      (then (return (f32.add (f32.const 190) (f32.mul (f32.convert_i32_s (local.get $level)) (f32.const 25))))))
    (f32.add
      (select (f32.const 148) (select (f32.const 125) (f32.const 94) (i32.eqz (local.get $type)))
        (i32.eq (local.get $type) (i32.const 2)))
      (f32.mul (f32.convert_i32_s (local.get $level)) (f32.const 19))))
  (func $can_place (export "can_place") (param $x f32) (param $y f32) (result i32)
    (local $d f32) (local $t i32)
    (if (i32.or (f32.ne (local.get $x) (local.get $x)) (f32.ne (local.get $y) (local.get $y)))
      (then (return (i32.const 0))))
    (if (i32.or (i32.or (f32.lt (local.get $x) (f32.const 24)) (f32.gt (local.get $x) (f32.const 936)))
                (i32.or (f32.lt (local.get $y) (f32.const 26)) (f32.gt (local.get $y) (f32.const 454))))
      (then (return (i32.const 0))))
    (loop $track
      (if (f32.lt (call $dist (local.get $x) (local.get $y)
        (call $pos (local.get $d) (i32.const 0)) (call $pos (local.get $d) (i32.const 1))) (f32.const 2304))
        (then (return (i32.const 0))))
      (local.set $d (f32.add (local.get $d) (f32.const 12)))
      (br_if $track (f32.le (local.get $d) (f32.const 1783))))
    (local.set $t (i32.const 12288))
    (loop $towers
      (if (i32.load (local.get $t))
        (then (if (f32.lt (call $dist (local.get $x) (local.get $y)
          (f32.load offset=4 (local.get $t)) (f32.load offset=8 (local.get $t))) (f32.const 1936))
          (then (return (i32.const 0))))))
      (local.set $t (i32.add (local.get $t) (i32.const 48)))
      (br_if $towers (i32.lt_u (local.get $t) (i32.const 14592))))
    (i32.const 1))
  (func (export "place") (param $type i32) (param $x f32) (param $y f32) (result i32)
    (local $t i32) (local $price i32)
    (if (i32.or (i32.gt_u (local.get $type) (i32.const 4)) (i32.ge_u (i32.load (i32.const 12)) (i32.const 2)))
      (then (return (i32.const -1))))
    (local.set $price (call $cost (local.get $type)))
    (if (i32.or (i32.lt_s (i32.load (i32.const 0)) (local.get $price))
      (i32.eqz (call $can_place (local.get $x) (local.get $y)))) (then (return (i32.const -1))))
    (local.set $t (i32.const 12288))
    (loop $find
      (if (i32.eqz (i32.load (local.get $t)))
        (then
          (memory.fill (local.get $t) (i32.const 0) (i32.const 48))
          (i32.store (local.get $t) (i32.const 1))
          (f32.store offset=4 (local.get $t) (local.get $x))
          (f32.store offset=8 (local.get $t) (local.get $y))
          (i32.store offset=12 (local.get $t) (local.get $type))
          (i32.store offset=36 (local.get $t) (local.get $price))
          (call $add (i32.const 0) (i32.sub (i32.const 0) (local.get $price)))
          (return (i32.div_u (i32.sub (local.get $t) (i32.const 12288)) (i32.const 48)))))
      (local.set $t (i32.add (local.get $t) (i32.const 48)))
      (br_if $find (i32.lt_u (local.get $t) (i32.const 14592))))
    (i32.const -1))
  (func $tower (param $id i32) (result i32)
    (if (i32.ge_u (local.get $id) (i32.const 48)) (then (return (i32.const 0))))
    (i32.add (i32.const 12288) (i32.mul (local.get $id) (i32.const 48))))
  (func $upgrade_cost (export "upgrade_cost") (param $id i32) (result i32)
    (local $t i32)
    (local.set $t (call $tower (local.get $id)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (i32.load (local.get $t))) (i32.ge_u (i32.load offset=16 (local.get $t)) (i32.const 3)))
      (then (return (i32.const 0))))
    (i32.mul (call $cost (i32.load offset=12 (local.get $t))) (i32.add (i32.const 1) (i32.load offset=16 (local.get $t)))))
  (func (export "upgrade") (param $id i32) (result i32)
    (local $t i32) (local $c i32)
    (local.set $t (call $tower (local.get $id)))
    (local.set $c (call $upgrade_cost (local.get $id)))
    (if (i32.or (i32.eqz (local.get $c)) (i32.or (i32.ge_u (i32.load (i32.const 12)) (i32.const 2))
      (i32.lt_s (i32.load (i32.const 0)) (local.get $c)))) (then (return (i32.const 0))))
    (call $add (i32.const 0) (i32.sub (i32.const 0) (local.get $c)))
    (call $add (i32.add (local.get $t) (i32.const 16)) (i32.const 1))
    (call $add (i32.add (local.get $t) (i32.const 36)) (local.get $c))
    (i32.const 1))
  (func (export "sell") (param $id i32) (result i32)
    (local $t i32) (local $cash i32)
    (local.set $t (call $tower (local.get $id)))
    (if (i32.eqz (local.get $t)) (then (return (i32.const 0))))
    (if (i32.or (i32.eqz (i32.load (local.get $t))) (i32.ge_u (i32.load (i32.const 12)) (i32.const 2)))
      (then (return (i32.const 0))))
    (local.set $cash (i32.div_u (i32.mul (i32.load offset=36 (local.get $t)) (i32.const 3)) (i32.const 4)))
    (call $add (i32.const 0) (local.get $cash))
    (i32.store (local.get $t) (i32.const 0))
    (local.get $cash))
  (func (export "start") (result i32)
    (if (i32.load (i32.const 12)) (then (return (i32.const 0))))
    (call $add (i32.const 8) (i32.const 1))
    (i32.store (i32.const 24) (i32.add (i32.const 12) (i32.mul (i32.load (i32.const 8)) (i32.const 4))))
    (i32.store (i32.const 12) (i32.const 1))
    (global.set $spawn (i32.const 0))
    (global.set $serial (i32.const 0))
    (i32.const 1))
  (func $spawn_balloon
    (local $b i32) (local $hp i32) (local $type i32) (local $w i32)
    (local.set $b (i32.const 1024))
    (block $full (loop $slot
      (br_if $full (i32.ge_u (local.get $b) (i32.const 9216)))
      (if (i32.eqz (i32.load (local.get $b))) (then
        (local.set $w (i32.load (i32.const 8)))
        (local.set $hp (i32.add (i32.const 1)
          (i32.rem_u (global.get $serial) (i32.add (i32.const 1) (i32.div_u (local.get $w) (i32.const 3))))))
        (if (i32.gt_u (local.get $hp) (i32.const 5)) (then (local.set $hp (i32.const 5))))
        ;; Every sixth balloon is a shell after wave 10. Bosses at 10,20,30.
        (if (i32.and (i32.ge_u (local.get $w) (i32.const 10)) (i32.eqz (i32.rem_u (global.get $serial) (i32.const 6))))
          (then (local.set $hp (i32.const 12)) (local.set $type (i32.const 6))))
        (if (i32.and (i32.ge_u (local.get $w) (i32.const 16)) (i32.eqz (i32.rem_u (global.get $serial) (i32.const 9))))
          (then (local.set $hp (i32.const 24)) (local.set $type (i32.const 7))))
        (if (i32.and (i32.eqz (i32.rem_u (local.get $w) (i32.const 10))) (i32.eqz (global.get $serial)))
          (then (local.set $hp (i32.mul (local.get $w) (i32.const 12))) (local.set $type (i32.const 8))))
        (memory.fill (local.get $b) (i32.const 0) (i32.const 32))
        (i32.store (local.get $b) (i32.const 1))
        (i32.store offset=16 (local.get $b) (local.get $hp))
        (i32.store offset=20 (local.get $b) (local.get $type))
        (f32.store offset=8 (local.get $b) (f32.const -24))
        (f32.store offset=12 (local.get $b) (f32.const 110))
        (call $add (i32.const 24) (i32.const -1))
        (global.set $serial (i32.add (global.get $serial) (i32.const 1)))
        (return)))
      (local.set $b (i32.add (local.get $b) (i32.const 32)))
      (br $slot))))
  (func $hit (param $b i32) (param $damage i32) (param $t i32)
    (local $dealt i32)
    (local.set $dealt (select (local.get $damage) (i32.load offset=16 (local.get $b))
      (i32.lt_s (local.get $damage) (i32.load offset=16 (local.get $b)))))
    (call $add (i32.add (local.get $b) (i32.const 16)) (i32.sub (i32.const 0) (local.get $dealt)))
    (call $add (i32.const 0) (local.get $dealt))
    (call $add (i32.const 16) (local.get $dealt))
    (call $add (i32.add (local.get $t) (i32.const 32)) (local.get $dealt))
    (i32.store offset=28 (local.get $b) (i32.const 6))
    (if (i32.le_s (i32.load offset=16 (local.get $b)) (i32.const 0))
      (then (i32.store (local.get $b) (i32.const 0))))
    (if (i32.le_s (i32.load offset=16 (local.get $b)) (i32.const 5))
      (then (i32.store offset=20 (local.get $b) (i32.const 0)))))
  (func $fire (param $t i32)
    (local $b i32) (local $target i32) (local $best f32) (local $r f32)
    (local $type i32) (local $level i32) (local $damage i32) (local $e i32)
    (local $x f32) (local $y f32)
    (local.set $type (i32.load offset=12 (local.get $t)))
    (local.set $level (i32.load offset=16 (local.get $t)))
    (local.set $r (call $sq (call $range (local.get $type) (local.get $level))))
    (local.set $best (f32.const -1))
    (local.set $b (i32.const 1024))
    (loop $search
      (if (i32.and (i32.load (local.get $b))
        (i32.or (i32.ne (i32.load offset=20 (local.get $b)) (i32.const 6)) (i32.eq (local.get $type) (i32.const 2))))
        (then (if (i32.and
          (f32.le (call $dist (f32.load offset=4 (local.get $t)) (f32.load offset=8 (local.get $t))
            (f32.load offset=8 (local.get $b)) (f32.load offset=12 (local.get $b))) (local.get $r))
          (f32.gt (f32.load offset=4 (local.get $b)) (local.get $best)))
          (then (local.set $target (local.get $b)) (local.set $best (f32.load offset=4 (local.get $b)))))))
      (local.set $b (i32.add (local.get $b) (i32.const 32)))
      (br_if $search (i32.lt_u (local.get $b) (i32.const 9216))))
    (if (i32.eqz (local.get $target)) (then (return)))
    (local.set $x (f32.load offset=8 (local.get $target)))
    (local.set $y (f32.load offset=12 (local.get $target)))
    (f32.store offset=24 (local.get $t) (local.get $x))
    (f32.store offset=28 (local.get $t) (local.get $y))
    (local.set $e (i32.add (i32.const 24576) (i32.mul (global.get $event) (i32.const 24))))
    (global.set $event (i32.rem_u (i32.add (global.get $event) (i32.const 1)) (i32.const 256)))
    (f32.store (local.get $e) (f32.load offset=4 (local.get $t)))
    (f32.store offset=4 (local.get $e) (f32.load offset=8 (local.get $t)))
    (f32.store offset=8 (local.get $e) (local.get $x))
    (f32.store offset=12 (local.get $e) (local.get $y))
    (i32.store offset=16 (local.get $e) (i32.const 12))
    (i32.store offset=20 (local.get $e) (local.get $type))
    (local.set $damage (i32.add (i32.const 1) (local.get $level)))
    (if (i32.eq (local.get $type) (i32.const 2))
      (then (local.set $damage (i32.mul (local.get $damage) (i32.const 3)))))
    (if (i32.or (i32.eqz (local.get $type)) (i32.eq (local.get $type) (i32.const 4)))
      (then (call $hit (local.get $target) (local.get $damage) (local.get $t)))
      (else
        (if (i32.ne (local.get $type) (i32.const 2))
          (then (local.set $x (f32.load offset=4 (local.get $t))) (local.set $y (f32.load offset=8 (local.get $t))))
          (else (local.set $r (call $sq (f32.add (f32.const 60) (f32.mul (f32.convert_i32_s (local.get $level)) (f32.const 10)))))))
        (local.set $b (i32.const 1024))
        (loop $area
          (if (i32.and (i32.load (local.get $b))
            (i32.or (i32.ne (i32.load offset=20 (local.get $b)) (i32.const 6)) (i32.eq (local.get $type) (i32.const 2))))
            (then (if (f32.le (call $dist (local.get $x) (local.get $y)
              (f32.load offset=8 (local.get $b)) (f32.load offset=12 (local.get $b))) (local.get $r))
              (then
                (if (i32.eq (local.get $type) (i32.const 3))
                  (then (i32.store offset=24 (local.get $b) (i32.add (i32.const 100) (i32.mul (local.get $level) (i32.const 30))))))
                (call $hit (local.get $b) (local.get $damage) (local.get $t))))))
          (local.set $b (i32.add (local.get $b) (i32.const 32)))
          (br_if $area (i32.lt_u (local.get $b) (i32.const 9216))))))
    (i32.store offset=20 (local.get $t)
      (i32.sub (select (i32.const 70) (select (i32.const 52) (i32.const 30) (i32.eq (local.get $type) (i32.const 1)))
        (i32.ge_u (local.get $type) (i32.const 2)))
        (i32.mul (local.get $level) (i32.const 6))))
    (if (i32.eq (local.get $type) (i32.const 4))
      (then (i32.store offset=20 (local.get $t) (i32.sub (i32.const 6) (local.get $level))))))
  (func (export "step")
    (local $b i32) (local $t i32) (local $n i32) (local $speed f32) (local $hp i32)
    (if (i32.ne (i32.load (i32.const 12)) (i32.const 1)) (then (return)))
    (call $add (i32.const 28) (i32.const 1))
    (if (i32.gt_s (i32.load (i32.const 24)) (i32.const 0))
      (then
        (global.set $spawn (i32.sub (global.get $spawn) (i32.const 1)))
        (if (i32.le_s (global.get $spawn) (i32.const 0))
          (then (call $spawn_balloon)
            (global.set $spawn (i32.sub (i32.const 38) (select (i32.load (i32.const 8)) (i32.const 26)
              (i32.lt_u (i32.load (i32.const 8)) (i32.const 26)))))))))
    (local.set $b (i32.const 1024))
    (loop $move
      (if (i32.load (local.get $b)) (then
        (local.set $hp (i32.load offset=16 (local.get $b)))
        (local.set $speed (f32.add (f32.const 1.05) (f32.mul (f32.convert_i32_s
          (select (local.get $hp) (i32.const 4) (i32.lt_u (local.get $hp) (i32.const 5)))) (f32.const 0.24))))
        (if (i32.eq (i32.load offset=20 (local.get $b)) (i32.const 8)) (then (local.set $speed (f32.const 0.8))))
        (if (i32.gt_s (i32.load offset=24 (local.get $b)) (i32.const 0))
          (then (local.set $speed (f32.mul (local.get $speed) (f32.const 0.45)))
            (call $add (i32.add (local.get $b) (i32.const 24)) (i32.const -1))))
        (f32.store offset=4 (local.get $b) (f32.add (f32.load offset=4 (local.get $b)) (local.get $speed)))
        (f32.store offset=8 (local.get $b) (call $pos (f32.load offset=4 (local.get $b)) (i32.const 0)))
        (f32.store offset=12 (local.get $b) (call $pos (f32.load offset=4 (local.get $b)) (i32.const 1)))
        (if (i32.gt_s (i32.load offset=28 (local.get $b)) (i32.const 0))
          (then (call $add (i32.add (local.get $b) (i32.const 28)) (i32.const -1))))
        (if (f32.ge (f32.load offset=4 (local.get $b)) (f32.const 1783))
          (then (i32.store (local.get $b) (i32.const 0))
            (call $add (i32.const 4) (i32.sub (i32.const 0) (local.get $hp)))))))
      (local.set $b (i32.add (local.get $b) (i32.const 32)))
      (br_if $move (i32.lt_u (local.get $b) (i32.const 9216))))
    (local.set $t (i32.const 12288))
    (loop $shoot
      (if (i32.load (local.get $t))
        (then (if (i32.gt_s (i32.load offset=20 (local.get $t)) (i32.const 0))
          (then (call $add (i32.add (local.get $t) (i32.const 20)) (i32.const -1)))
          (else (call $fire (local.get $t))))))
      (local.set $t (i32.add (local.get $t) (i32.const 48)))
      (br_if $shoot (i32.lt_u (local.get $t) (i32.const 14592))))
    (local.set $b (i32.const 1024))
    (loop $count
      (local.set $n (i32.add (local.get $n) (i32.load (local.get $b))))
      (local.set $b (i32.add (local.get $b) (i32.const 32)))
      (br_if $count (i32.lt_u (local.get $b) (i32.const 9216))))
    (i32.store (i32.const 20) (local.get $n))
    (local.set $b (i32.const 24576))
    (loop $fade
      (if (i32.gt_s (i32.load offset=16 (local.get $b)) (i32.const 0))
        (then (call $add (i32.add (local.get $b) (i32.const 16)) (i32.const -1))))
      (local.set $b (i32.add (local.get $b) (i32.const 24)))
      (br_if $fade (i32.lt_u (local.get $b) (i32.const 30720))))
    (if (i32.le_s (i32.load (i32.const 4)) (i32.const 0))
      (then (i32.store (i32.const 4) (i32.const 0)) (i32.store (i32.const 12) (i32.const 2)) (return)))
    (if (i32.eqz (i32.add (local.get $n) (i32.load (i32.const 24))))
      (then
        (call $add (i32.const 0) (i32.add (i32.const 100) (i32.mul (i32.load (i32.const 8)) (i32.const 8))))
        (i32.store (i32.const 12) (select (i32.const 3) (i32.const 0) (i32.ge_u (i32.load (i32.const 8)) (i32.const 30)))))))
